{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock: Hold = Ctrl, Tap = Fn (language switch)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "parameters": { "basic.to_if_alone_timeout_milliseconds": 300 },
                                "to": [{ "key_code": "left_control" }],
                                "to_if_alone": [{ "apple_vendor_top_case_key_code": "keyboard_fn" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Enter: Tap = Shift+Enter (newline), Hold = Enter (submit)",
                        "enabled": false,
                        "manipulators": [
                            {
                                "from": { "key_code": "return_or_enter" },
                                "parameters": {
                                    "basic.to_if_alone_timeout_milliseconds": 200,
                                    "basic.to_if_held_down_threshold_milliseconds": 200
                                },
                                "to_if_alone": [
                                    {
                                        "key_code": "return_or_enter",
                                        "modifiers": ["left_shift"]
                                    }
                                ],
                                "to_if_held_down": [{ "key_code": "return_or_enter" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Vim: jk → Escape (insert mode exit). Outputs 'j' immediately if not followed by 'k'",
                        "enabled": false,
                        "manipulators": [
                            {
                                "from": { "key_code": "j" },
                                "to": [
                                    { "key_code": "j" },
                                    {
                                        "set_variable": {
                                            "name": "vim_jk_sequence",
                                            "value": 1
                                        }
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "vim_jk_sequence",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": { "key_code": "k" },
                                "to": [
                                    { "key_code": "backspace" },
                                    { "key_code": "escape" },
                                    {
                                        "set_variable": {
                                            "name": "vim_jk_sequence",
                                            "value": 0
                                        }
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
