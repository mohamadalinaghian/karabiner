
{
  "rules": [
    {
      "description": "Caps Lock: tap = Control+Space (switch language), hold = Control",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock"
          },
          "to_if_alone": [
            {
              "key_code": "space",
              "modifiers": ["control"]
            }
          ],
          "to": [
            {
              "key_code": "left_control"
            }
          ],
          "conditions": [
            {
              "type": "vi_mode",
              "name": "vi_mode"
            }
          ]
        }
      ]
    },
    {
      "description": "Control + h/j/k/l = arrow keys (Vim-like, global)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "key_code": "left_arrow"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "j",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "key_code": "down_arrow"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "k",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "key_code": "up_arrow"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "l",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "key_code": "right_arrow"
            }
          ]
        }
      ]
    },
    {
      "description": "Control + e = end of line, Control + b = beginning of line, Control + d = delete next char",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "e",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "key_code": "end",
              "modifiers": ["control"]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "b",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "key_code": "home",
              "modifiers": ["control"]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "d",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "key_code": "forward_delete"
            }
          ]
        }
      ]
    },
    {
      "description": "j then k = Escape (Vim: from insert to normal mode). Outputs 'j' immediately if not followed by 'k'",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "j"
          },
          "to": [
            {
              "key_code": "j"
            },
            {
              "set_variable": {
                "name": "jk_pending",
                "value": 1
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "k"
          },
          "to": [
            {
              "key_code": "backspace"
            },
            {
              "key_code": "escape"
            },
            {
              "set_variable": {
                "name": "jk_pending",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "jk_pending",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "any": "key_code"
          },
          "to": [
            {
              "set_variable": {
                "name": "jk_pending",
                "value": 0
              }
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "jk_pending",
              "value": 1
            }
          ]
        }
      ]
    }
  ]
}
